    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^27.1.0",
    "json-server": "1.0.0-beta.15",
