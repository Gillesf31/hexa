meta {
  name: List appointments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/appointments
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("includes both seeded appointments", function() {
    expect(res.status).to.equal(200);
    expect(res.body.map((appointment) => appointment.id)).to.include.members(["1", "2"]);
  });
}
