meta {
  name: List appointments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/appointments
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("returns the seeded appointments in the wire shape", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.lengthOf.above(0);

    for (const appointment of res.body) {
      expect(Object.keys(appointment).sort()).to.eql([
        "customerName",
        "date",
        "durationMinutes",
        "id",
        "startTime",
      ]);
      expect(appointment.date).to.match(/^\d{4}-\d{2}-\d{2}$/);
      expect(appointment.startTime).to.match(/^\d{2}:\d{2}$/);
    }
  });
}
