meta {
  name: Filter appointments — two on one day
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/appointments?date={{multiMatchDate}}
  body: none
  auth: none
}

params:query {
  date: {{multiMatchDate}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("returns every appointment booked on that date, not just the first", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.lengthOf(2);
    expect(res.body.every((appointment) => appointment.date === bru.getEnvVar("multiMatchDate"))).to.equal(true);
  });
}
