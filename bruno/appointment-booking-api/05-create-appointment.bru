meta {
  name: Create appointment
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/appointments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customerName": "Gilles",
    "date": "2026-08-05",
    "startTime": "09:30",
    "durationMinutes": 60
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("creates an appointment with a generated string id", function() {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("string");
  });
}
