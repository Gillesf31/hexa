meta {
  name: Filter appointments — one match
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/appointments?date={{singleMatchDate}}
  body: none
  auth: none
}

params:query {
  date: {{singleMatchDate}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("returns only the appointments booked on that date", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.lengthOf(1);
    expect(res.body.map((appointment) => appointment.date)).to.eql([bru.getEnvVar("singleMatchDate")]);
  });
}
