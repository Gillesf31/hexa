{
  "name": "book",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/book/src",
  "tags": ["scope:book", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/book",
        "browser": "apps/book/src/main.ts",
        "tsConfig": "apps/book/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/book/public"
          }
        ],
        "styles": ["apps/book/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "memory": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/book/src/environments/environment.ts",
              "with": "apps/book/src/environments/environment.memory.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "dependsOn": ["api"],
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "book:build:production"
        },
        "development": {
          "buildTarget": "book:build:development"
        }
      }
    },
    "serve-memory": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "buildTarget": "book:build:memory"
      }
    },
    "api": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run api"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run apps/book/src --passWithNoTests"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "book:build",
        "staticFilePath": "dist/apps/book/browser",
        "spa": true
      }
    }
  }
}
